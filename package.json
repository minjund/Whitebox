{
  "name": "whitebox-ai",
  "version": "2.0.8",
  "description": "A terminal workspace that connects every AI task to its own understanding and review.",
  "main": "main.js",
  "author": "wincube AX",
  "license": "MIT",
  "homepage": "https://github.com/minjund/Whitebox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minjund/Whitebox.git"
  },
  "bugs": {
    "url": "https://github.com/minjund/Whitebox/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "codex",
    "gemini",
    "grok",
    "electron",
    "desktop"
  ],
  "engines": {
    "node": ">=18"
  },
  "whitebox": {
    "distributionChannel": "internal",
    "allowUnsignedWindowsUpdates": true,
    "allowUnsignedMacUpdates": true
  },
  "files": [
    "bin",
    "build/icon.png",
    "build/icon.ico",
    "build/generated/whitebox-signature-check.exe",
    "main.js",
    "preload.js",
    "attention-popup-preload.js",
    "brand-profile-recovery-preload.js",
    "renderer",
    "src",
    "docs/*.md",
    "docs/assets/whitebox-demo.gif",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md",
    "README.ko.md",
    "README.zh-CN.md"
  ],
  "bin": {
    "whitebox": "bin/whitebox.js"
  },
  "scripts": {
    "start": "electron .",
    "check:source": "node scripts/check-source.js",
    "check:package": "node scripts/package-content-check.js",
    "check:release-assets": "node scripts/release-asset-contract.js",
    "test:accuracy": "node scripts/accuracy-evaluation.js",
    "test:terminal": "electron scripts/terminal-integration-test.js && electron scripts/ghostty-terminal-check.js && npm run test:workspace",
    "test:terminal:engine": "electron scripts/ghostty-terminal-check.js",
    "test:terminal:ime": "electron scripts/terminal-ime-check.js",
    "test:terminal:startup": "electron scripts/comprehension-startup-pty-check.js",
    "test:terminal:tmux-pane": "electron scripts/exact-tmux-pane-integration.js",
    "test:terminal:managed": "electron scripts/managed-tmux-integration-test.js",
    "test:terminal:mac-stress": "node scripts/mac-terminal-stress-check.js",
    "test:terminal-restart": "node scripts/terminal-restart-persistence-check.js",
    "test:bridge": "electron scripts/bridge-integration-test.js",
    "test:tmux": "node scripts/tmux-integration-test.js",
    "test:attention-popup": "electron scripts/attention-popup-integration.js",
    "test:brand-profile-recovery": "electron scripts/brand-profile-recovery-check.js",
    "test:interim-profile-guard": "electron scripts/interim-profile-guard-check.js",
    "test:brand-surface": "electron scripts/brand-surface-check.js",
    "test:update:mac": "node scripts/mac-update-integration-test.js",
    "test:artifacts:mac": "node scripts/mac-artifact-check.js",
    "test:artifacts:win": "node scripts/windows-artifact-check.js",
    "test:artifacts:win:legacy-bridge": "node scripts/windows-legacy-update-bridge-check.js",
    "test:update:win:legacy-bridge": "node scripts/windows-legacy-update-bridge-integration.js",
    "test:update:win:v173": "node scripts/windows-v173-update-integration.js",
    "test:update:win:frozen": "node scripts/windows-v173-update-integration.js",
    "check:update:cohorts": "node scripts/check-update-compatibility-cohorts.js",
    "check:update:legacy": "node scripts/check-legacy-update-channel.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never",
    "dist:win:legacy-bridge": "electron-builder --win --publish never --config scripts/legacy-update-bridge.config.js",
    "dist:mac": "electron-builder --mac --publish never",
    "pack": "electron-builder --dir",
    "prepublishOnly": "npm run check:source && npm test && npm run check:package",
    "test:workspace": "node scripts/terminal-activity-test.js && node scripts/terminal-review-test.js && node scripts/terminal-collaboration-test.js && node scripts/panel-provider-test.js && electron scripts/terminal-workspace-check.js && electron scripts/terminal-workspace-check.js --responsive-only && node scripts/workspace-attention-runner.js",
    "test": "node scripts/regression-test.js && node scripts/execution-activity-test.js && node scripts/workspace-source-contract.js && node scripts/update-restart-regression.js && node scripts/electron-asar-cleanup-check.js",
    "test:performance": "node --expose-gc scripts/performance-monitor-check.js && electron scripts/terminal-input-performance-check.js && electron scripts/process-monitor-worker-check.js",
    "test:result-review": "node scripts/terminal-review-test.js",
    "test:drawer-conversation": "electron scripts/ghostty-terminal-check.js",
    "test:drawer-actual-pty": "node scripts/workspace-attention-runner.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@crunchloop/ghostty-web": "0.4.6",
    "node-pty": "1.2.0-beta.14"
  },
  "peerDependencies": {
    "electron": "^44.3.0"
  },
  "devDependencies": {
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.wincube.whitebox",
    "productName": "Whitebox",
    "executableName": "Whitebox",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US",
      "ko",
      "zh-CN",
      "zh_CN"
    ],
    "files": [
      "main.js",
      "preload.js",
      "attention-popup-preload.js",
      "brand-profile-recovery-preload.js",
      "build/icon.png",
      "build/icon.ico",
      "bin/**/*",
      "src/**/*",
      "renderer/**/*",
      "LICENSE",
      "package.json",
      "!node_modules/@crunchloop/ghostty-web/dist/*.d.ts"
    ],
    "asarUnpack": [
      "bin/**/*",
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "beforePack": "scripts/before-pack.js",
    "win": {
      "extraResources": [
        {
          "from": "build/generated/whitebox-signature-check.exe",
          "to": "whitebox-signature-check.exe"
        }
      ],
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Whitebox-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Whitebox-${version}-portable.exe",
      "unpackDirName": false
    },
    "nsis": {
      "guid": "c5e80817-3fef-5203-be10-660aa7355425",
      "artifactName": "Whitebox-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  }
}
